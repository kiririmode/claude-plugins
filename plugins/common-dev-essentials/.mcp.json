{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--enable-web-dashboard",
        "false",
        "--context",
        "ide-assistant",
        "--project",
        "${PROJECT_ROOT}"
      ],
      "env": {
        "PROJECT_ROOT": "${PWD}"
      }
    }
  }
}
