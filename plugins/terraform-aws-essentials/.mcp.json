{
  "mcpServers": {
    "terraform": {
      "type": "stdio",
      "command": "docker",
      "args": ["run", "-i", "--rm", "hashicorp/terraform-mcp-server:latest"],
      "env": {}
    },
    "awslabs.terraform-mcp-server": {
      "command": "docker",
      "args": ["run", "--rm", "--interactive", "--env", "FASTMCP_LOG_LEVEL=ERROR", "awslabs/terraform-mcp-server:latest"]
    },
    "awslabs.aws-documentation-mcp-server": {
      "command": "docker",
      "args": ["run", "--rm", "--interactive", "--env", "FASTMCP_LOG_LEVEL=ERROR", "--env", "AWS_DOCUMENTATION_PARTITION=aws", "mcp/aws-documentation:latest"]
    },
    "awslabs.aws-pricing-mcp-server": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "--interactive",
        "--env",
        "FASTMCP_LOG_LEVEL=ERROR",
        "--env-file",
        "${PROJECT_ROOT}/.env",
        "awslabs/aws-pricing-mcp-server:latest"
      ]
    }
  }
}
